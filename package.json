{
  "name": "nebula-music",
  "productName": "Nebula Music",
  "version": "0.2.0",
  "description": "Nebula: Universal modern desktop music player for YouTube Music, Spotify & SoundCloud with built-in ad blocker",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --win"
  },
  "devDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "youtubei.js": "^18.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "author": "Nebula Projects",
  "build": {
    "appId": "app.nebula.music",
    "productName": "Nebula Music",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Nebula-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Nebula-Portable-${version}.${ext}"
    }
  }
}
